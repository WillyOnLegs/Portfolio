# NOTE : ces règles ne tournent que sur Apache (willyol.com). Sur Vercel ce fichier est ignoré.
# Les liens du site utilisent les URL propres (/work, /about, /contact, /mentions-legales).

# ==============================================================
# WillyOL — URLs propres (clean URLs)
# ==============================================================

# ==============================================================
# HTTPS obligatoire + page 404
# ==============================================================

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Laisse passer le renouvellement du certificat SSL
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --------------------------------------------------------------
    # 1) Redirections 301 — anciennes URLs vers les nouvelles propres
    # --------------------------------------------------------------

    # /index.html  ->  /
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # /pages/projets/<slug>.html  ->  /work/<slug>
    RewriteCond %{THE_REQUEST} \s/+pages/projets/([^/.\s?]+)\.html[\s?] [NC]
    RewriteRule ^ /work/%1 [R=301,L]

    # /pages/projets.html  ->  /work
    RewriteCond %{THE_REQUEST} \s/+pages/projets\.html[\s?] [NC]
    RewriteRule ^ /work [R=301,L]

    # /pages/apropos.html  ->  /about
    RewriteCond %{THE_REQUEST} \s/+pages/apropos\.html[\s?] [NC]
    RewriteRule ^ /about [R=301,L]

    # /pages/mentions-legales.html  ->  /mentions-legales
    RewriteCond %{THE_REQUEST} \s/+pages/mentions-legales\.html[\s?] [NC]
    RewriteRule ^ /mentions-legales [R=301,L]

    # /pages/contact.html  ->  /contact
    RewriteCond %{THE_REQUEST} \s/+pages/contact\.html[\s?] [NC]
    RewriteRule ^ /contact [R=301,L]

    # /work/flouz/  ->  /work/flouz (sans slash final, sinon les images ne se chargent pas)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(work(?:/[^/.]+)?|about|contact|mentions-legales)/$ /$1 [R=301,L]

    # --------------------------------------------------------------
    # 2) Réécritures internes — URL propre  ->  fichier réel
    # --------------------------------------------------------------

    # /work/<slug>  ->  /pages/projets/<slug>.html
    RewriteRule ^work/([^/.]+)/?$ /pages/projets/$1.html [L]

    # /work  ->  /pages/projets.html
    RewriteRule ^work/?$ /pages/projets.html [L]

    # /about  ->  /pages/apropos.html
    RewriteRule ^about/?$ /pages/apropos.html [L]

    # /contact  ->  /pages/contact.html
    RewriteRule ^contact/?$ /pages/contact.html [L]

    # /mentions-legales  ->  /pages/mentions-legales.html
    RewriteRule ^mentions-legales/?$ /pages/mentions-legales.html [L]
</IfModule>

# ==============================================================
# Performance — compression + cache navigateur
# ==============================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html                "access plus 0 seconds"
    ExpiresByType text/css                 "access plus 7 days"
    ExpiresByType application/javascript   "access plus 7 days"
    ExpiresByType text/javascript          "access plus 7 days"
    ExpiresByType image/webp               "access plus 30 days"
    ExpiresByType image/jpeg               "access plus 30 days"
    ExpiresByType image/png                "access plus 30 days"
    ExpiresByType image/svg+xml            "access plus 30 days"
    ExpiresByType video/mp4                "access plus 30 days"
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType video/mp4 .mp4
</IfModule>
